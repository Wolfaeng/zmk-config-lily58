/*
 * Bone-Layout fuer Lily58 (ZMK) - QWERTZ-Version mit zmk-locales
 * ------------------------------------------------------------------
 * Diese Keymap nutzt das Modul "zmk-locales" (joelspadin) und dessen
 * German-Header. Dadurch schreibst du direkt das Zeichen, das erscheinen
 * soll (DE_...), und musst nicht mehr im Kopf auf US-QWERTY umrechnen.
 *
 * Voraussetzung:
 *   1) PC/OS ist auf DEUTSCH (QWERTZ) eingestellt.
 *   2) Modul in config/west.yml eingetragen (siehe Chat / README).
 *
 * Hinweis Totentasten (Dead Keys) auf QWERTZ:
 *   DE_CARET (^), DE_GRAVE (`) und DE_ACUTE (´) erscheinen erst,
 *   wenn danach Leertaste oder ein Buchstabe folgt. Das ist normal.
 *
 * Layer:
 *   0 = Bone Grundebene
 *   1 = SYM  (Programmier-/Sonderzeichen)
 *   2 = NAV  (Pfeile, Navigation, Ziffern-Block-Ersatz, F-Tasten, BT)
 * ------------------------------------------------------------------
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <locale/keys_de.h>

&nice_view_spi {
cs-gpios = <&pro_micro 4 GPIO_ACTIVE_HIGH>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        /* =============================================================
         * Layer 0 - Bone Grundebene
         *
         *   j d u a x        p h l m w
         *   c t i e o        b n r s g
         *   f v ue ae oe     z y , . k
         *
         * (Shift liefert automatisch die Grossbuchstaben-Ebene.)
         * ============================================================= */
        default_layer {
            // -----------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3  |  4  |  5  |                     |  6  |  7  |  8  |  9  |  0  |  ss   |
            // |  TAB  |  j  |  d  |  u  |  a  |  x  |                     |  p  |  h  |  l  |  m  |  w  |  q    |
            // | CTRL  |  c  |  t  |  i  |  e  |  o  |                     |  b  |  n  |  r  |  s  |  g  |  '    |
            // | SHIFT |  f  |  v  | ue  | ae  | oe  | [ |         | ] |   |  z  |  y  |  ,  |  .  |  k  | SHIFT |
            //                     | ALT | GUI | SYM | SPACE | | ENT | NAV | BSPC| GUI |
            bindings = <
                &kp ESC   &kp DE_N1 &kp DE_N2 &kp DE_N3       &kp DE_N4       &kp DE_N5                             &kp DE_N6 &kp DE_N7 &kp DE_N8    &kp DE_N9  &kp DE_N0 &kp DE_SHARP_S
                &kp TAB   &kp DE_J  &kp DE_D  &kp DE_U        &kp DE_A        &kp DE_X                              &kp DE_P  &kp DE_H  &kp DE_L     &kp DE_M   &kp DE_W  &kp DE_Q
                &kp LCTRL &kp DE_C  &kp DE_T  &kp DE_I        &kp DE_E        &kp DE_O                              &kp DE_B  &kp DE_N  &kp DE_R     &kp DE_S   &kp DE_G  &kp DE_APOS
                &kp LSHFT &kp DE_F  &kp DE_V  &kp DE_U_UMLAUT &kp DE_A_UMLAUT &kp DE_O_UMLAUT &kp DE_LBKT &kp DE_RBKT  &kp DE_Z  &kp DE_Y  &kp DE_COMMA &kp DE_DOT &kp DE_K  &kp RSHFT
                                              &kp LALT        &kp LGUI        &mo 1           &kp SPACE   &kp RET   &mo 2     &kp BSPC  &kp RGUI
            >;
        };

        /* =============================================================
         * Layer 1 - SYM (Programmier- und Sonderzeichen)
         *
         *   ...  _  [  ]  ^        !  <  >  =  &  \
         *    \   /  {  }  *        ?  (  )  +  :  @
         *    #   $  |  ~  `        %  EUR ;  ,  .
         * ============================================================= */
        sym_layer {
            bindings = <
                &trans      &trans        &trans      &trans      &trans       &trans                          &trans       &trans      &trans      &trans      &trans      &trans
                &trans      &kp DE_UNDER  &kp DE_LBKT &kp DE_RBKT &kp DE_CARET &trans                          &kp DE_EXCL  &kp DE_LT   &kp DE_GT   &kp DE_EQUAL &kp DE_AMPS &kp DE_BSLH
                &kp DE_BSLH &kp DE_SLASH  &kp DE_LBRC &kp DE_RBRC &kp DE_ASTRK &trans                          &kp DE_QMARK &kp DE_LPAR &kp DE_RPAR &kp DE_PLUS  &kp DE_COLON &kp DE_AT
                &kp DE_HASH &kp DE_DLLR   &kp DE_PIPE &kp DE_TILDE &kp DE_GRAVE &trans     &trans     &trans    &kp DE_PRCNT &kp DE_EURO &kp DE_SEMI &kp DE_COMMA &kp DE_DOT  &trans
                                                      &trans      &trans       &trans     &trans     &trans    &trans       &trans      &trans
            >;
        };

        /* =============================================================
         * Layer 2 - NAV (Pfeile, Navigation, F-Tasten, Bluetooth)
         * (unveraendert - alles layout-unabhaengige Funktionstasten)
         * ============================================================= */
        nav_layer {
            // |BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |         |     | HOME| END |PGUP |PGDN |     |
            // | F1  | F2  | F3  | F4  | F5  | F6  |         | INS | <-  |  v  |  ^  | ->  | DEL |
            // | F7  | F8  | F9  | F10 | F11 | F12 |         |     |     |     |     |     |     |
            bindings = <
                &bt BT_CLR  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4              &trans   &kp HOME  &kp END   &kp PG_UP &kp PG_DN &trans
                &kp F1      &kp F2       &kp F3       &kp F4       &kp F5       &kp F6                     &kp INS  &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &kp DEL
                &kp F7      &kp F8       &kp F9       &kp F10      &kp F11      &kp F12                    &trans   &trans    &trans    &trans    &trans    &trans
                &trans      &trans       &trans       &trans       &trans       &trans   &trans   &trans   &trans   &trans    &trans    &trans    &trans    &trans
                                                      &trans       &trans       &trans   &trans   &trans   &trans   &trans    &trans
            >;
        };
    };
};
