/*
 * Bone-Layout fuer Lily58 (ZMK) - QWERTZ-Version mit zmk-locales
 * ------------------------------------------------------------------
 * Diese Keymap nutzt das Modul "zmk-locales" (joelspadin) und dessen
 * German-Header. Dadurch schreibst du direkt das Zeichen, das erscheinen
 * soll (DE_...), und musst nicht mehr im Kopf auf US-QWERTY umrechnen.
 *
 * Voraussetzung:
 *   1) PC/OS ist auf DEUTSCH (QWERTZ) eingestellt.
 *   2) Modul in config/west.yml eingetragen (siehe Chat / README).
 *
 * Hinweis Totentasten (Dead Keys) auf QWERTZ:
 *   DE_CARET (^), DE_GRAVE (`) und DE_ACUTE (´) erscheinen erst,
 *   wenn danach Leertaste oder ein Buchstabe folgt. Das ist normal.
 *
 * Layer:
 *   0 = Bone Grundebene
 *   1 = SYM  (Programmier-/Sonderzeichen)
 *   2 = NAV  (Pfeile, Navigation, Ziffern-Block-Ersatz, F-Tasten, BT)
 * ------------------------------------------------------------------
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <locale/keys_de.h>

&nice_view_spi {
cs-gpios = <&pro_micro 4 GPIO_ACTIVE_HIGH>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp ESC &none &none &none &kp F5 &kp F12 &none &none &none &none &none &none
                &kp TAB &kp DE_J &kp DE_D &kp DE_U &kp DE_A &kp DE_X &kp DE_P &kp DE_H &kp DE_L &kp DE_M &kp DE_W &kp DE_SHARP_S
                &kp LCTRL &kp DE_C &kp DE_T &kp DE_I &kp DE_E &kp DE_O &kp DE_B &kp DE_N &kp DE_R &kp DE_S &kp DE_G &kp DE_Q
                &kp LSHFT &kp DE_F &kp DE_V &kp DE_U_UMLAUT &kp DE_A_UMLAUT &kp DE_O_UMLAUT &kp DE_LBKT &kp LCTRL &kp DE_Y &kp DE_Z &kp DE_COMMA &kp DE_DOT &kp DE_K &kp RSHFT
                &kp LALT &kp LGUI &mo 1 &kp SPACE &kp RET &kp BSPC &mo 2 &mo 3
            >;
        };

        sym_layer {
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &kp DE_UNDER &kp DE_LBKT &kp DE_RBKT &kp DE_CARET &kp DE_EXCL &kp DE_EXCL &kp DE_LT &kp DE_GT &kp DE_EQUAL &kp DE_AMPS &none
                &none &kp DE_BSLH &kp DE_SLASH &kp DE_LBRC &kp DE_RBRC &kp DE_ASTRK &kp DE_QMARK &kp DE_LPAR &kp DE_RPAR &kp DE_MINUS &kp DE_COLON &kp DE_AT
                &none &kp DE_HASH &kp DE_DLLR &kp DE_PIPE &kp DE_TILDE &kp DE_GRAVE &trans &trans &kp DE_PLUS &kp DE_PRCNT &kp DE_DQT &kp DE_APOS &kp DE_SEMI &trans
                &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        nav_layer {
            bindings = <
                &bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &trans &kp HOME &kp END &kp PG_UP &kp PG_DN &trans
                &kp F1 &kp F2 &kp F3 &kp F4 &kp F5 &kp F6 &kp INS &trans &kp UP &none &trans &kp DEL
                &kp F7 &kp F8 &kp F9 &kp F10 &kp F11 &kp F12 &trans &kp LEFT &kp DOWN &kp RIGHT &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };

        numbers_layer {
            bindings = <
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &kp DE_N7 &kp DE_N8 &kp DE_N9 &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &kp DE_N4 &kp DE_N5 &kp DE_N6 &trans
                &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &kp DE_N1 &kp DE_N2 &kp DE_N3 &kp DE_N0
                &trans &trans &trans &trans &trans &trans &trans &trans
            >;
        };
    };
};
