/*
 * Bone-Layout fuer Lily58 (ZMK)
 * ------------------------------------------------------------------
 * WICHTIG: Diese Keymap geht davon aus, dass dein PC/OS auf
 *          DEUTSCH (QWERTZ) eingestellt ist!
 *
 * ZMK sendet US-HID-Keycodes. Der PC interpretiert sie als QWERTZ.
 * Deshalb stehen in den Bindings teils "komische" Keycodes:
 *   z.B. &kp Y  ->  ergibt auf QWERTZ ein "z"
 *        &kp Z  ->  ergibt auf QWERTZ ein "y"
 *        &kp LBKT -> "ue"   &kp SQT -> "ae"   &kp SEMI -> "oe"
 *        &kp MINUS -> "ss"
 *
 * Layer:
 *   0 = Bone Grundebene (Ebene 1) + Shift gibt Ebene 2 (Grossbuchstaben)
 *   1 = SYM  (praktische Bone Ebene 3: Programmier-/Sonderzeichen)
 *   2 = NAV  (Pfeile, Navigation, Ziffern, F-Tasten, Bluetooth)
 *
 * Aktivierung ueber Daumentasten (siehe unterste Reihe).
 * ------------------------------------------------------------------
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

/* ------------------------------------------------------------------
 * AltGr-Zeichen fuer QWERTZ als Makros
 * (Zeichen, die man auf DE nur mit AltGr = RALT erreicht)
 * ------------------------------------------------------------------ */
/ {
    macros {
        m_at:    m_at    { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp RA(Q)>;    label = "AT"; };      // @
        m_euro:  m_euro  { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp RA(E)>;    label = "EURO"; };    // EUR
        m_lbrc:  m_lbrc  { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp RA(N7)>;   label = "LBRC"; };    // {
        m_lbkt:  m_lbkt  { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp RA(N8)>;   label = "LBKT"; };    // [
        m_rbkt:  m_rbkt  { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp RA(N9)>;   label = "RBKT"; };    // ]
        m_rbrc:  m_rbrc  { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp RA(N0)>;   label = "RBRC"; };    // }
        m_bslh:  m_bslh  { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp RA(MINUS)>; label = "BSLH"; };   // '\'
        m_tilde: m_tilde { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp RA(RBKT)>; label = "TILDE"; };   // ~
        m_pipe:  m_pipe  { compatible = "zmk,behavior-macro"; #binding-cells = <0>; bindings = <&kp RA(NON_US_BSLH)>; label = "PIPE"; }; // |
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        /* =============================================================
         * Layer 0 - Bone Grundebene (Ebene 1)
         *
         * Bone-Buchstabenanordnung (das was auf dem Schirm erscheint):
         *   j d u a x        p h l m w  ss
         *   c t i e o        b n r s g  q
         *   f v ue ae oe     y z ,  .  k
         *
         * Shift liefert automatisch Ebene 2 (Grossbuchstaben + auf DE
         * die ueblichen Shift-Zeichen der Zahlenreihe).
         * ============================================================= */
        default_layer {
            // ----------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3  |  4  |  5  |                 |  6  |  7  |  8  |  9  |  0  |  ss   |
            // |  TAB  |  j  |  d  |  u  |  a  |  x  |                 |  p  |  h  |  l  |  m  |  w  |  q    |
            // | CTRL  |  c  |  t  |  i  |  e  |  o  |                 |  b  |  n  |  r  |  s  |  g  |  '    |
            // | SHIFT |  f  |  v  | ue  | ae  | oe  | [ |     | ] |   |  z  |  y  |  ,  |  .  |  k  | SHIFT |
            //                     | ALT | GUI | SYM | SPACE | | ENT | NAV | BSPC| GUI |
            bindings = <
                &kp ESC   &kp N1  &kp N2  &kp N3    &kp N4    &kp N5                       &kp N6  &kp N7   &kp N8    &kp N9  &kp N0  &kp MINUS
                &kp TAB   &kp J   &kp D   &kp U     &kp A     &kp X                        &kp P   &kp H    &kp L     &kp M   &kp W   &kp Q
                &kp LCTRL &kp C   &kp T   &kp I     &kp E     &kp O                        &kp B   &kp N    &kp R     &kp S   &kp G   &kp SQT
                &kp LSHFT &kp F   &kp V   &kp LBKT  &kp SQT   &kp SEMI &kp NUBS   &kp RA(N8) &kp Y  &kp Z    &kp COMMA &kp DOT &kp K   &kp RSHFT
                                          &kp LALT  &kp LGUI  &mo 1    &kp SPACE  &kp RET   &mo 2   &kp BSPC &kp RGUI
            >;
        };

        /* =============================================================
         * Layer 1 - SYM (praktische Bone Ebene 3)
         *
         * Programmier- und Sonderzeichen. Anordnung an Neo/Bone Ebene 3
         * angelehnt, aber nur mit auf QWERTZ erzeugbaren Zeichen.
         *
         *   ...  _  [  ]  ^        !  <  >  =  &  '\'
         *    \   /  {  }  *        ?  (  )  +  :  @
         *    #   $  |  ~  `        +  -  ;  ,  .  -
         * ============================================================= */
        sym_layer {
            // Zeichen als Kommentar = was erscheint (QWERTZ)
            // Reihe1: (leer) _  [  ]  ^
            // Reihe2:  \  /  {  }  *
            // Reihe3:  #  $  |  ~  =
            bindings = <
                &trans     &trans      &trans     &trans     &trans     &trans                        &trans      &trans      &trans     &trans     &trans     &trans
                &trans     &kp UNDER   &m_lbkt    &m_rbkt    &kp CARET  &trans                        &kp EXCL    &kp LT      &kp GT     &kp EQUAL  &kp AMPS   &m_bslh
                &m_bslh    &kp SLASH   &m_lbrc    &m_rbrc    &kp ASTRK  &trans                        &kp QMARK   &kp LPAR    &kp RPAR   &kp PLUS   &kp COLON  &m_at
                &kp HASH   &kp DLLR    &m_pipe    &m_tilde   &kp GRAVE  &trans     &trans   &trans    &kp PRCNT   &m_euro     &kp SEMI   &kp COMMA  &kp DOT    &trans
                                                  &trans     &trans     &trans     &trans   &trans    &trans      &trans      &trans
            >;
        };

        /* =============================================================
         * Layer 2 - NAV (Pfeile, Navigation, Ziffern, F-Tasten, BT)
         *
         * Pfeile liegen auf der rechten Hand (Bone-Homerow-naeah):
         *   LEFT DOWN UP RIGHT  auf  n r s g Positionen
         * Links: F-Tasten + Bluetooth-Verwaltung.
         * ============================================================= */
        nav_layer {
            // |BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |         |     | HOME| END |PGUP |PGDN |     |
            // | F1  | F2  | F3  | F4  | F5  | F6  |         | INS | <-  |  v  |  ^  | ->  | DEL |
            // | F7  | F8  | F9  | F10 | F11 | F12 |         |     |     |     |     |     |     |
            bindings = <
                &bt BT_CLR  &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4              &trans   &kp HOME  &kp END   &kp PG_UP &kp PG_DN &trans
                &kp F1      &kp F2       &kp F3       &kp F4       &kp F5       &kp F6                     &kp INS  &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT &kp DEL
                &kp F7      &kp F8       &kp F9       &kp F10      &kp F11      &kp F12                    &trans   &trans    &trans    &trans    &trans    &trans
                &trans      &trans       &trans       &trans       &trans       &trans   &trans   &trans   &trans   &trans    &trans    &trans    &trans    &trans
                                                      &trans       &trans       &trans   &trans   &trans   &trans   &trans    &trans
            >;
        };
    };
};
